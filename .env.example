# Copy this file to .env.local and fill in your Supabase project values.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public URL used for authentication redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: comma-separated emails allowed to create an account.
# Leave empty to allow any signup. Set this for a private personal instance.
ALLOWED_SIGNUP_EMAILS=
